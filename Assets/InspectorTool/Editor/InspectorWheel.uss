.quantum-root { flex-grow: 1; min-width: 0; min-height: 0; overflow: hidden; background-color: #060b18; color: #dcefff; }
.quantum-header { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 12px 18px; border-bottom-width: 1px; border-bottom-color: #203856; background-color: #091222; }
.quantum-brand { flex-grow: 1; }
.quantum-eyebrow { color: #67b9da; font-size: 10px; letter-spacing: 3px; }
.quantum-title { color: #e4f9ff; font-size: 19px; -unity-font-style: bold; letter-spacing: 2px; }
.quantum-body { flex-grow: 1; flex-basis: 0; min-height: 0; min-width: 0; flex-direction: row; overflow: hidden; }
.quantum-header, .quantum-navigation, .quantum-footer { flex-shrink: 0; min-width: 0; }
.quantum-navigation Button { flex-shrink: 0; }
.quantum-navigation { background-color: #0a1529; border-bottom-width: 1px; border-bottom-color: #203856; padding: 5px 12px; }
.quantum-tabs { flex-direction: row; align-items: center; flex-wrap: wrap; }
.quantum-tabs .navigation-tab { min-width: 112px; font-size: 13px; padding: 7px 16px; -unity-font-style: bold; }
.quantum-tabs .active-tab { background-color: #174258; border-color: #65e7fb; color: #ffffff; }
.quantum-breadcrumb { color: #9ec9df; font-size: 11px; overflow: hidden; text-overflow: ellipsis; margin: 3px 6px; }
.hub-switch { font-size: 10px; }
.quantum-wheel { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; overflow: hidden; }
.quantum-stage { position: absolute; width: 640px; height: 640px; transform-origin: 0 0; }
.quantum-hub { position: absolute; left: 203px; top: 203px; width: 234px; height: 234px; border-radius: 117px; border-width: 2px; border-color: #35caed; background-color: #0b1830; align-items: center; justify-content: center; padding: 14px; }
.quantum-hub .hub-symbol { color: #62e5ff; font-size: 14px; -unity-text-align: middle-center; }
.quantum-hub .hub-name { font-size: 19px; -unity-font-style: bold; color: #ecfaff; white-space: normal; -unity-text-align: middle-center; max-height: 48px; overflow: hidden; }
.quantum-hub .hub-subtitle { font-size: 10px; color: #8cacc7; margin-top: 2px; margin-bottom: 4px; max-width: 190px; overflow: hidden; text-overflow: ellipsis; }
.quantum-search { width: 178px; height: 26px; min-height: 26px; flex-direction: row; align-items: center; margin-bottom: 6px; background-color: #050c1b; border-color: #387798; border-width: 1px; border-radius: 5px; }
.search-magnifier { width: 16px; height: 16px; flex-shrink: 0; margin-left: 6px; margin-right: 4px; }
.quantum-search TextField { flex-grow: 1; min-width: 0; margin: 0; }
.quantum-search .unity-base-field__input { background-color: transparent; background-image: none; color: #d3f5ff; border-width: 0; padding: 1px 0; }
.quantum-root .quantum-search .search-clear { width: 20px; height: 20px; padding: 0; margin: 0 2px; border-width: 0; background-color: transparent; background-image: none; font-size: 14px; }
.hub-count { color: #70e1fb; font-size: 11px; }
.hub-history, .hub-component-actions { flex-direction: row; margin-top: 0; flex-shrink: 0; }
.quantum-root .quantum-hub Button { margin: 2px; padding: 2px 7px; font-size: 10px; max-width: 174px; overflow: hidden; text-overflow: ellipsis; }
.quantum-root .quantum-hub .hub-parent { color: #a0dbea; max-width: 180px; }
.quantum-root Button { background-color: #12283d; color: #bdefff; border-color: #315c78; border-width: 1px; border-radius: 5px; padding: 5px 10px; margin: 3px; }
.quantum-root Button:hover { background-color: #204762; border-color: #68d5ec; color: white; }
.quantum-root Button:disabled { opacity: .4; }
.quantum-root Toggle { color: #a7d8eb; margin: 5px; }
.quantum-node { position: absolute; width: 112px; height: 112px; border-radius: 64px; border-width: 2px; border-color: #788ba9; background-color: #0d1a30; align-items: center; justify-content: center; padding: 10px; }
.quantum-node.compact { width: 94px; height: 94px; }
.quantum-node.large { width: 128px; height: 128px; }
.quantum-node:hover { background-color: #203553; }
.quantum-node.selected { background-color: #173653; border-width: 3px; border-color: #e1faff; }
.quantum-node .node-name { color: #e9f5ff; -unity-text-align: middle-center; font-size: 11px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
.asset-preview { height: 100px; margin-bottom: 8px; }
.node-glyph { font-size: 22px; -unity-font-style: bold; color: #c0d8ff; }
.node-meta { font-size: 9px; color: #8faec9; margin-top: 4px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
.node-icon { width: 24px; height: 24px; flex-shrink: 0; }
.alias-fields { margin-top: 8px; margin-bottom: 10px; }
.alias-fields .unity-base-field__label { min-width: 82px; }
.alias-editor { padding: 16px; }
.category-transform { border-color: #53f5ed; }
.category-rendering { border-color: #428fff; }
.category-physics { border-color: #88ef91; }
.category-audio { border-color: #ffbd60; }
.category-script { border-color: #bd85ff; }
.category-missing { border-color: #ef697b; }
.quantum-footer { height: 48px; padding: 8px 16px; align-self: stretch; overflow: hidden; border-top-width: 1px; border-top-color: #203856; background-color: #091222; }
.quantum-hint { color: #7299b7; font-size: 10px; }
.quantum-status { color: #9cdcf1; font-size: 11px; }
.quantum-footer > Label { align-self: stretch; min-width: 0; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.quantum-panels { width: 320px; flex-shrink: 0; min-width: 0; min-height: 0; border-left-width: 1px; border-left-color: #274764; background-color: #0b1425; padding: 8px; }
.quantum-panels.wide { width: 420px; }
.quantum-body .quantum-workspace { min-width: 340px; }
.quantum-body .quantum-panels { min-width: 240px; }
.quantum-body .unity-two-pane-split-view__dragline-anchor { width: 8px; margin-left: -4px; }
.quantum-body .unity-two-pane-split-view__dragline { width: 2px; margin-left: 3px; background-color: #315c78; }
.quantum-body .unity-two-pane-split-view__dragline-anchor:hover > .unity-two-pane-split-view__dragline,
.quantum-body .unity-two-pane-split-view__dragline-anchor.resizing > .unity-two-pane-split-view__dragline { background-color: #68d5ec; }
.research-panel { margin-bottom: 12px; padding: 10px; background-color: #0e1d31; border-radius: 7px; border-top-width: 1px; border-top-color: #3f688a; }
.research-title { font-size: 13px; -unity-font-style: bold; color: #6de4ff; margin-bottom: 8px; }
.research-line { color: #a8c4dc; font-size: 11px; white-space: normal; margin-bottom: 5px; }
.research-value { color: #e1f2ff; white-space: normal; margin-bottom: 6px; }
.research-actions { flex-direction: row; flex-wrap: wrap; }
.research-link { margin-top: 5px; padding: 6px; border-left-width: 2px; border-left-color: #9878df; background-color: #101a32; }
.relationship-hierarchy { border-left-color: #46dceb; }
.relationship-event { border-left-color: #ffc367; }
.relationship-dependency { border-left-color: #81dd91; }
.relationship-instrumented { border-left-color: #ff78ca; }
.relationship-scriptableobject { border-left-color: #4f9cff; }
.research-graph { height: 210px; margin-bottom: 10px; }
.quantum-empty { color: #f0c983; font-size: 11px; }
.quantum-hidden { display: none; }
.quantum-panels .unity-scroll-view__content-container { min-width: 0; }
.quantum-property-editor { min-width: 0; margin: 6px 0; }
.quantum-property-editor .unity-base-field { min-width: 0; }
.quantum-property-editor .unity-base-field__label { min-width: 76px; max-width: 130px; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; }
.quantum-property-editor .unity-base-field__input { min-width: 0; }
.component-catalog { height: 330px; min-height: 180px; margin: 6px 0; }
.quantum-search.catalog-search { width: auto; min-width: 0; align-self: stretch; }
.hub-component-actions .active-tab { border-color: #ffd18b; background-color: #382b26; }
.component-catalog Button { white-space: normal; -unity-text-align: middle-left; }
.quantum-node.removable { border-color: #ffd18b; background-color: #382b26; }
.quantum-node.removal-blocked { background-color: #111825; border-color: #3a4859; }
.quantum-node.removal-blocked .node-name { color: #8093a8; }
.quantum-focus-ghost { position: absolute; width: 112px; height: 112px; border-radius: 60px; border-width: 2px; border-color: #adf5ff; background-color: #14314c; padding: 12px; align-items: center; justify-content: center; }
.quantum-focus-ghost .node-name { font-size: 11px; color: #edfcff; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }

.quantum-workspace { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; overflow: hidden; }
.quantum-graph-workspace { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; overflow: hidden; }
.graph-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; padding: 2px 5px; background-color: #0a1728; border-bottom-width: 1px; border-bottom-color: #203856; }
.graph-toolbar Button { font-size: 10px; padding: 4px 6px; margin: 2px; }
.graph-toolbar Toggle { font-size: 10px; margin: 3px 8px; }
.graph-toolbar ToolbarMenu { font-size: 10px; min-height: 24px; }
.graph-toolbar .graph-search { width: 150px; margin: 2px; }
.graph-progress { flex-grow: 1; flex-basis: 120px; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #8bbacb; font-size: 10px; margin: 4px; }
.quantum-graph-viewport { flex-grow: 1; flex-basis: 0; min-height: 0; min-width: 0; overflow: hidden; background-color: #060d1b; }
.quantum-graph-node { position: absolute; left: 0; top: 0; border-width: 1px; border-radius: 12px; background-color: #102139; color: #e6f7ff; padding: 8px 26px 8px 30px; justify-content: center; overflow: hidden; }
.quantum-graph-node:hover { background-color: #1d3b55; border-width: 2px; }
.quantum-graph-node.graph-selected { background-color: #21475e; border-width: 3px; }
.quantum-graph-node.graph-cluster { border-radius: 18px; background-color: #112b3c; }
.quantum-graph-node.graph-cluster-selected { background-color: #25506b; border-width: 3px; }
.quantum-graph-node.graph-pinned { border-bottom-width: 4px; }
.quantum-graph-node.graph-match { background-color: #40512c; border-width: 3px; }
.quantum-graph-node.graph-dim { opacity: .4; }
.graph-node-title { -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.graph-node-subtitle { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #a2c4d5; margin-top: 2px; }
.graph-node-glyph, .graph-node-icon { position: absolute; left: 6px; top: 9px; width: 20px; height: 22px; font-size: 16px; -unity-text-align: middle-center; }
.quantum-root .graph-node-expand { position: absolute; right: 3px; top: 3px; width: 20px; height: 20px; padding: 0; margin: 0; font-size: 13px; background-color: #143448; }
.quantum-graph-node.graph-compact { padding: 3px 20px 3px 5px; border-radius: 8px; }
.graph-compact .graph-node-glyph, .graph-compact .graph-node-icon { display: none; }
