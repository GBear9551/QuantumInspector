.quantum-focus-ghost .node-name { font-size: 11px; color: #edfcff; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }

.quantum-workspace { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; overflow: hidden; }
.quantum-graph-workspace { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; overflow: hidden; }
.graph-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; padding: 2px 5px; background-color: #0a1728; border-bottom-width: 1px; border-bottom-color: #203856; }
.graph-toolbar Button { font-size: 11px; padding: 4px 6px; margin: 2px; }
.graph-toolbar Toggle { font-size: 11px; margin: 3px 8px; }
.graph-toolbar ToolbarMenu { font-size: 11px; min-height: 24px; }
.graph-toolbar .graph-search { width: 150px; margin: 2px; }
.graph-progress { flex-grow: 1; flex-basis: 120px; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #9babc5; font-size: 11px; margin: 4px; }
.quantum-graph-viewport { flex-grow: 1; flex-basis: 0; min-height: 0; min-width: 0; overflow: hidden; background-color: #060d1b; }
.quantum-graph-node { position: absolute; left: 0; top: 0; border-width: 1px; border-radius: 12px; background-color: #102139; color: #e6f7ff; padding: 8px 26px 8px 30px; justify-content: center; overflow: hidden; }
.quantum-graph-node:hover { background-color: #1d3b55; border-width: 2px; }
.quantum-graph-node.graph-selected { background-color: #21475e; border-width: 3px; }
.quantum-graph-node.graph-cluster { border-radius: 18px; background-color: #112b3c; }
.quantum-graph-node.graph-cluster-selected { background-color: #25506b; border-width: 3px; }
.quantum-graph-node.graph-pinned { border-bottom-width: 4px; }
.quantum-graph-node.graph-match { background-color: #40512c; border-width: 3px; }
.quantum-graph-node.graph-dim { opacity: .4; }
.graph-node-title { -unity-font-style: bold; white-space: normal; overflow: visible; flex-shrink: 0; }
.graph-node-subtitle { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #a2c4d5; margin-top: 2px; }
.graph-node-glyph, .graph-node-icon { position: absolute; left: 6px; top: 9px; width: 20px; height: 22px; font-size: 16px; -unity-text-align: middle-center; }
.quantum-root .graph-node-expand { position: absolute; right: 3px; top: 3px; width: 20px; height: 20px; padding: 0; margin: 0; font-size: 13px; background-color: #143448; }
.graph-node-resize { position: absolute; right: 3px; bottom: 3px; width: 14px; height: 14px; border-right-width: 2px; border-bottom-width: 2px; border-right-color: #6d98b5; border-bottom-color: #6d98b5; cursor: resize-up-left; }
.graph-node-resize:hover { border-right-color: #c3f4ff; border-bottom-color: #c3f4ff; }
.quantum-graph-node.graph-compact { padding: 3px 20px 3px 5px; border-radius: 8px; }
.graph-compact .graph-node-glyph, .graph-compact .graph-node-icon { display: none; }
.graph-legend { font-size: 11px; color: #a2c4d5; padding: 3px 8px; white-space: normal; flex-shrink: 0; }
.graph-relationship-detail { font-size: 11px; color: #d3e7ef; padding: 3px 8px; white-space: normal; height: 74px; min-height: 74px; max-height: 74px; overflow: hidden; flex-shrink: 0; }
.quantum-graph-node.graph-asset { padding-bottom: 64px; }
.graph-node-preview { position: absolute; width: 48px; height: 48px; left: 30px; bottom: 8px; }
.graph-light .quantum-graph-viewport { background-color: #e9eef3; }
.graph-light .graph-toolbar { background-color: #dae3ed; border-bottom-color: #a7b6c6; }
.graph-light .quantum-graph-node { background-color: #f8fafc; color: #162b40; }
.graph-light .quantum-graph-node.graph-cluster { background-color: #d8e5ef; }
.graph-light .quantum-graph-node.graph-selected, .graph-light .quantum-graph-node.graph-cluster-selected { background-color: #bedbeb; }
.graph-light .graph-node-subtitle, .graph-light .graph-legend, .graph-light .graph-relationship-detail, .graph-light .graph-progress { color: #263e54; }
.quantum-root .graph-light Button, .quantum-root .graph-light Toggle, .graph-light .unity-base-field { color: #1e3b51; }
.quantum-root .graph-light Button { background-color: #dce8ef; border-color: #738da2; }
.graph-light .graph-search { background-color: #f6f8fb; }
.graph-light .graph-search .unity-base-field__input { color: #16334c; }
.graph-light .graph-legend, .graph-light .graph-relationship-detail { background-color: #e9eef3; }
.graph-light .unity-toggle__label { color: #263e54; }
.graph-edge-count { position: absolute; font-size: 11px; color: #d5eaf7; background-color: #0c192a; padding: 1px 3px; border-radius: 3px; }
.graph-light .graph-edge-count { color: #243a4d; background-color: #eef3f8; }

.graph-art-layer, .graph-node-surface { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.graph-nebula-backdrop { position: absolute; left: -8px; top: -8px; right: -8px; bottom: -8px; }
.graph-toolbar .unity-enum-field { min-width: 90px; max-width: 160px; margin: 3px; }
.graph-toolbar .unity-enum-field__input { background-color: #152034; color: #e6efff; border-width: 1px; border-color: #40536c; min-height: 22px; }
.graph-cosmic .quantum-graph-viewport { background-color: #070b18; }
.graph-cosmic .quantum-graph-node { background-color: #0c1327; border-radius: 9px; }
