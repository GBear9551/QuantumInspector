.graph-cosmic .quantum-graph-node.graph-selected { border-width: 3px; }
.graph-cosmic .quantum-graph-node.graph-disabled { border-left-width: 4px; }
.quantum-graph-node.graph-missing { border-left-width: 5px; }
.graph-cosmic .quantum-graph-node.graph-pinned { border-bottom-width: 4px; }
