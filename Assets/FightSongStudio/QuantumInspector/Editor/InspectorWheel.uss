.category-physics { border-color: #88ef91; }
.category-audio { border-color: #ffbd60; }
.category-script { border-color: #bd85ff; }
.category-missing { border-color: #ef697b; }
.quantum-footer { height: 48px; padding: 8px 16px; align-self: stretch; overflow: hidden; border-top-width: 1px; border-top-color: #203856; background-color: #091222; }
.quantum-hint { color: #7299b7; font-size: 10px; }
.quantum-credit { height: 22px; min-height: 22px; flex-shrink: 0; padding: 2px 10px; margin: 0; background-color: #091222; color: #a8c6db; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; }
.quantum-status { color: #9cdcf1; font-size: 11px; }
.quantum-footer > Label { align-self: stretch; min-width: 0; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.quantum-panels { width: 320px; flex-shrink: 0; min-width: 0; min-height: 0; border-left-width: 1px; border-left-color: #274764; background-color: #0b1425; padding: 8px; }
.quantum-panels.wide { width: 420px; }
.quantum-body .quantum-workspace { min-width: 340px; }
.quantum-body .quantum-panels { min-width: 240px; }
.quantum-body .unity-two-pane-split-view__dragline-anchor { width: 16px; margin-left: -8px; cursor: resize-horizontal; }
.quantum-body .unity-two-pane-split-view__dragline { width: 2px; margin-left: 7px; background-color: #315c78; }
.quantum-body .unity-two-pane-split-view__dragline-anchor:hover > .unity-two-pane-split-view__dragline,
.quantum-body .unity-two-pane-split-view__dragline-anchor.resizing > .unity-two-pane-split-view__dragline { background-color: #68d5ec; }
.research-panel { margin-bottom: 12px; padding: 10px; background-color: #0e1d31; border-radius: 7px; border-top-width: 1px; border-top-color: #3f688a; }
.research-title { font-size: 13px; -unity-font-style: bold; color: #6de4ff; margin-bottom: 8px; }
.research-line { color: #a8c4dc; font-size: 11px; white-space: normal; margin-bottom: 5px; }
.research-value { color: #e1f2ff; white-space: normal; margin-bottom: 6px; }
.research-actions { flex-direction: row; flex-wrap: wrap; }
.research-link { margin-top: 5px; padding: 6px; border-left-width: 2px; border-left-color: #9878df; background-color: #101a32; }
.relationship-hierarchy { border-left-color: #46dceb; }
.relationship-event { border-left-color: #ffc367; }
.relationship-dependency { border-left-color: #81dd91; }
.relationship-instrumented { border-left-color: #ff78ca; }
.relationship-scriptableobject { border-left-color: #4f9cff; }
.research-graph { height: 210px; margin-bottom: 10px; }
.quantum-empty { color: #f0c983; font-size: 11px; }
.quantum-hidden { display: none; }
.quantum-panels .unity-scroll-view__content-container { min-width: 0; }
.quantum-property-editor { min-width: 0; margin: 6px 0; }
