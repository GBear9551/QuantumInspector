.graph-toolbar .graph-dot-size { min-width: 175px; max-width: 210px; margin: 3px; }
.graph-dot-size .unity-base-field__label { min-width: 54px; margin-right: 4px; color: #e6efff; }
.graph-dot-size .unity-base-field__input { min-width: 90px; }
.graph-dot-size .unity-base-text-field__input { min-width: 32px; color: #e6efff; background-color: #152034; }
.quantum-window-resize-border { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.quantum-window-resize-handle { position: absolute; background-color: transparent; }
.quantum-window-resize-handle:hover, .quantum-window-resize-handle.resizing { background-color: rgba(104, 213, 236, 0.16); }
.quantum-window-resize-handle.resize-left { left: 0; top: 12px; bottom: 12px; width: 7px; cursor: resize-horizontal; }
.quantum-window-resize-handle.resize-right { right: 0; top: 12px; bottom: 12px; width: 7px; cursor: resize-horizontal; }
.quantum-window-resize-handle.resize-top { top: 0; left: 12px; right: 12px; height: 7px; cursor: resize-vertical; }
.quantum-window-resize-handle.resize-bottom { bottom: 0; left: 12px; right: 12px; height: 7px; cursor: resize-vertical; }
.quantum-window-resize-handle.resize-left.resize-top, .quantum-window-resize-handle.resize-right.resize-top,
.quantum-window-resize-handle.resize-left.resize-bottom, .quantum-window-resize-handle.resize-right.resize-bottom { width: 12px; height: 12px; }
.quantum-window-resize-handle.resize-left.resize-top { left: 0; top: 0; right: auto; bottom: auto; cursor: resize-up-left; }
.quantum-window-resize-handle.resize-right.resize-top { right: 0; top: 0; left: auto; bottom: auto; cursor: resize-up-right; }
.quantum-window-resize-handle.resize-left.resize-bottom { left: 0; bottom: 0; right: auto; top: auto; cursor: resize-up-right; }
.quantum-window-resize-handle.resize-right.resize-bottom { right: 0; bottom: 0; left: auto; top: auto; cursor: resize-up-left; }
