.orbital-inspector { position: absolute; overflow: hidden; background-color: #132436; border-width: 2px; border-top-color: #a1eff4; border-left-color: #548797; border-right-color: #12222d; border-bottom-color: #040c14; padding: 5px; }
.orbital-inspector-rim { flex-grow: 1; min-height: 0; border-radius: 13px; border-width: 1px; border-top-color: #263c4d; border-left-color: #263c4d; border-right-color: #6b9aa4; border-bottom-color: #527987; background-color: #101d2b; overflow: hidden; }
.orbital-inspector-content { flex-grow: 1; min-height: 0; padding: 10px; }
.orbital-inspector-navigation { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 7px; }
.quantum-root .orbital-inspector-navigation > Button { min-height: 28px; margin: 0 5px 0 0; }
.quantum-root .orbital-inspector-navigation > #orbitalInspectorReturn { margin-left: auto; margin-right: 0; background-color: #21485a; border-top-color: #7fc4d4; border-bottom-color: #0b1923; }
.orbital-inspector-title { font-size: 17px; -unity-font-style: bold; color: #eefaff; white-space: normal; flex-shrink: 0; margin: 0 3px; }
.orbital-inspector-context { font-size: 11px; color: #a0bbc8; margin: 3px 3px 10px; flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; }
.orbital-native-body { flex-grow: 1; min-height: 0; border-width: 1px; border-top-color: #0a1017; border-left-color: #0a1017; border-right-color: #4a5964; border-bottom-color: #4a5964; border-radius: 5px; padding: 4px; background-color: #383838; color: #d2d2d2; }
.orbital-native-body > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { min-width: 0; }
.quantum-root .orbital-native-body Button { background-color: #585858; color: #dedede; border-color: #303030; border-radius: 3px; padding: 2px 6px; margin: 2px; }
.quantum-root .orbital-native-body Button:hover { background-color: #676767; border-color: #707070; }
.quantum-root .orbital-native-body Toggle { color: #d2d2d2; margin: 0; }
.orbital-native-body.orbital-native-light { background-color: #c2c2c2; color: #222222; }
.quantum-root .orbital-native-light Button { background-color: #e4e4e4; color: #222222; border-color: #939393; }
.quantum-root .orbital-native-light Toggle { color: #222222; }

.graph-component-inspector { position: absolute; padding: 7px; min-width: 0; min-height: 0; overflow: hidden; border-width: 2px; border-top-color: #9edfea; border-left-color: #557b90; border-right-color: #172b3c; border-bottom-color: #08131d; border-radius: 10px; background-color: #142333; }
.graph-inspector-heading { flex-direction: row; align-items: center; flex-shrink: 0; }
.graph-inspector-title { flex-grow: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; color: #effaff; font-size: 13px; -unity-font-style: bold; }
.quantum-root .graph-inspector-heading > Button { flex-shrink: 0; padding: 2px 8px; margin: 0 0 0 4px; }
.graph-inspector-owner { flex-shrink: 0; color: #a4c3d3; font-size: 11px; overflow: hidden; text-overflow: ellipsis; margin: 4px 1px 8px; }

.graph-compact-toolbar, .graph-header-compact { flex-wrap: wrap; min-width: 0; }
#graphSettingsPanel #wheelFontScale, #graphSettingsPanel #nodeFontSize, #graphSettingsPanel #buttonFontSize { flex-shrink: 0; margin: 5px 0; }
#graphSettingsPanel #wheelFontScale > .unity-base-field__label, #graphSettingsPanel #nodeFontSize > .unity-base-field__label, #graphSettingsPanel #buttonFontSize > .unity-base-field__label { min-width: 140px; }
